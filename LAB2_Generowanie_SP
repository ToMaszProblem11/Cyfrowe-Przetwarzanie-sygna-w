% WERSJA TRUDNIEJSZA
fs=1000;
T=1/fs;
Tc=1;           %czas trwania s
t=0:1/fs:Tc-T;  %wektor czasu
f0=5;           %częstotliwość podstawowa fali prostokątnej
N=151;          %liczba harmonicznych(nieparzystych)

square_approx = zeros(size(t));
for k = 1:2:N;
    square_approx = square_approx + (1/k) * sin(2*pi*k*f0*t);
end
figure;
plot(square_approx,'-o');
grid on;
axis tight;



